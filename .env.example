# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/financial_rag_agent

# SEC EDGAR requires a descriptive User-Agent with contact info
SEC_USER_AGENT=Financial RAG Agent (you@example.com)

# Embeddings
# EMBEDDING_PROVIDER: "sentence-transformers" or "ollama"
# Each provider/model gets its own pgvector collection (see retrieval/vector_store.py),
# so switching providers never mixes incompatible vector spaces in the same collection.
# sentence-transformers runs in-process (no separate server to crash under
# load — verified live: embedding 719 chunks in one batch crashed Ollama's
# server process mid-request), so it's the default here now.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# To use Ollama instead, set:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
OLLAMA_BASE_URL=http://localhost:11434

# LLM (used by the eval harness's relevance judge for now)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# To use Claude instead (via the Anthropic API — billed separately at
# console.anthropic.com, NOT included in a Claude.ai/Claude Code
# subscription), set:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# Reranker (cross-encoder, used by hybrid_search_reranked)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval strategy used by the live /query endpoint: "baseline" | "hybrid" | "hybrid_reranked"
# Default is "hybrid" per real measured eval results (see eval_report.md) —
# hybrid beat both baseline and hybrid+reranked on every metric there.
RETRIEVAL_STRATEGY=hybrid

# Chunking
CHUNK_TARGET_TOKENS=900
CHUNK_OVERLAP_TOKENS=150
