# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/financial_rag_agent

# SEC EDGAR requires a descriptive User-Agent with contact info
SEC_USER_AGENT=Financial RAG Agent (you@example.com)

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OLLAMA_BASE_URL=http://localhost:11434

# Chunking
CHUNK_TARGET_TOKENS=900
CHUNK_OVERLAP_TOKENS=150
